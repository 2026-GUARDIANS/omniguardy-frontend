# true(기본): mock 구현 사용 / false: 실제 HTTP·WebSocket 구현 사용
EXPO_PUBLIC_USE_MOCK=true
# 실제 백엔드 주소 (USE_MOCK=false일 때 사용). 예: http://localhost:8080
EXPO_PUBLIC_API_BASE_URL=
# 디자인 테마: figma(기본, v1 디자인) / custom(v2 보안앱 톤). 앱 시작 시 한 번 정해짐
# 값을 바꾼 뒤에는 Metro 캐시를 비워야 반영됨: npx expo start --clear
EXPO_PUBLIC_THEME=figma
