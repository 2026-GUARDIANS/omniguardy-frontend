      "supportsTablet": true
    },
    "android": {
      "package": "cloud.omniguardy.app",
      "adaptiveIcon": {
        "backgroundColor": "#ffffff"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store"
    ]
  }
}
