{
  "expo": {
    "name": "OmniGuardy",
    "slug": "omniguardy-frontend",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "package": "cloud.omniguardy.app",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#717171"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {},
    "plugins": [
      "expo-font",
      "expo-status-bar",
      "expo-splash-screen",
      "expo-secure-store"
    ],
    "extra": {
      "eas": {
        "projectId": "e9032c19-1b5e-4ddf-8553-7ba054c758ad"
      }
    },
    "owner": "sunbi"
  }
}
